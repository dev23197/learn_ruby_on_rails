<%= form_with(model: handle) do |form| %>
  <% if handle.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(handle.errors.count, "error") %> prohibited this handle from being saved:</h2>

      <ul>
        <% handle.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, style: "display: block" %>
    <%= form.text_field :name %>
  </div>

  <div>
    <%= form.label :email, style: "display: block" %>
    <%= form.text_field :email %>
  </div>

  <div>
    <%= form.label :login, style: "display: block" %>
    <%= form.text_field :login %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
